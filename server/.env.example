# ============================================
# CareerLens AI — Server Environment Variables
# ============================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/careerlens

# JWT Secrets (generate strong random strings for production)
JWT_ACCESS_SECRET=your_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# AI Providers (add when reaching Phase 2)
# GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key

# India job boards (comma separated). Available: naukri, foundit, shine,
# timesjobs, freshersworld, internshala, cutshort, hirist, indeed_india, linkedin_india
JOB_SOURCES=naukri,foundit,shine,timesjobs,freshersworld,internshala,cutshort,hirist,indeed_india,linkedin_india

# Email (add when reaching Phase 6)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM=CareerLens AI <noreply@careerlens.ai>

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
