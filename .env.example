# ============================================
# CareerPilot AI — Server Environment Variables
# ============================================

# Server Configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/careerpilot

# Authentication (Change these in production!)
JWT_ACCESS_SECRET=your_access_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# AI Providers (Required for Resume Parsing & Smart Matching)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Email SMTP (Required for Job Alerts)
# e.g., for Gmail use smtp.gmail.com and an App Password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password_or_app_password
EMAIL_FROM="CareerPilot AI <noreply@careerpilot.com>"

# File Upload Settings
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
